{
  "name": "vuesion",
  "private": true,
  "version": "5.4.0",
  "description": "Vuesion is a boilerplate that helps product teams build faster than ever with fewer headaches and modern best practices across engineering & design.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuesion/vuesion.git"
  },
  "keywords": [
    "vue 3",
    "vite",
    "typescript",
    "server-side-rendering",
    "boilerplate",
    "vitetest",
    "enterprise",
    "components",
    "design-system",
    "nuxt 3",
    "composition-api"
  ],
  "author": "Johannes Werner <johannes.werner@hey.com>",
  "license": "MIT",
  "homepage": "https://github.com/vuesion/vuesion",
  "bugs": {
    "url": "https://github.com/vuesion/vuesion/issues"
  },
  "scripts": {
    "dev": "cross-env NODE_ICU_DATA=node_modules/full-icu nuxi dev",
    "storybook:dev": "rm -rf ./node_modules/.cache && storybook dev -p 6006",
    "test": "cross-env NODE_ICU_DATA=node_modules/full-icu vitest run --coverage",
    "test:app": "cross-env NODE_ICU_DATA=node_modules/full-icu vitest run --project app --coverage",
    "test:server": "cross-env NODE_ICU_DATA=node_modules/full-icu vitest run --project server --coverage",
    "test:tools": "cross-env NODE_ICU_DATA=node_modules/full-icu vitest run --project tools --coverage",
    "lint": "concurrently \"npm run lint:code\" \"npm run lint:style\"",
    "lint:code": "concurrently \"eslint --fix --cache .\" \"vue-tsc --project ./tsconfig.json --noEmit\"",
    "lint:style": "stylelint './src/app/**/*.{vue,scss,sass,css}' --fix",
    "new:component": "hygen new component",
    "new:field-set": "hygen new field-set",
    "new:form": "hygen new form",
    "new:page": "hygen new page",
    "new:rest-api": "hygen new rest-api",
    "new:store": "hygen new store",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node --transpile-only ./prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate-client": "prisma generate",
    "extract-i18n-messages": "ts-node --transpile-only ./tools/extract-i18n-messages.ts",
    "generate:swagger": "ts-node --transpile-only tools/openapi/generate-from-controllers/index.ts",
    "test:watch": "cross-env NODE_ICU_DATA=node_modules/full-icu vitest",
    "e2e": "cypress run --headless",
    "storybook:build": "storybook build",
    "release:major": "ts-node --transpile-only ./tools/release.ts --major",
    "release:minor": "ts-node --transpile-only ./tools/release.ts --minor",
    "release:patch": "ts-node --transpile-only ./tools/release.ts --patch",
    "build": "nuxi build",
    "build:analyze": "nuxi analyze",
    "build:spa": "nuxi generate",
    "start": "cross-env NODE_ICU_DATA=node_modules/full-icu node .output/server/index.mjs",
    "prepare": "husky",
    "postinstall": "prisma generate || true",
    "pre-commit": "pretty-quick --staged && concurrently \"npm run lint\" \"npm test\""
  },
  "dependencies": {
    "@floating-ui/vue": "1.1.9",
    "@pinia/nuxt": "0.11.3",
    "@prisma/client": "6.16.3",
    "@vee-validate/rules": "4.15.1",
    "@vueuse/core": "13.9.0",
    "animejs": "4.2.2",
    "bcrypt": "6.0.0",
    "colorjs.io": "0.5.2",
    "cross-env": "10.1.0",
    "full-icu": "1.5.0",
    "h3-compression": "0.3.2",
    "lodash-es": "4.17.21",
    "marked": "16.3.0",
    "mitt": "3.0.1",
    "next-auth": "4.21.1",
    "pinia": "3.0.4",
    "prisma": "6.16.3",
    "vee-validate": "4.15.1",
    "vue-tsc": "3.1.4"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.39.1",
    "@nuxt/devtools": "2.6.5",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/image": "1.11.0",
    "@nuxtjs/color-mode": "3.5.2",
    "@nuxtjs/html-validator": "2.1.0",
    "@nuxtjs/i18n": "10.2.1",
    "@nuxtjs/robots": "5.5.6",
    "@prisma/internals": "6.16.3",
    "@sidebase/nuxt-auth": "1.1.0",
    "@storybook/addon-a11y": "^9.1.9",
    "@storybook/addon-docs": "9.1.9",
    "@storybook/addon-links": "^9.1.9",
    "@storybook/addon-themes": "9.1.9",
    "@storybook/testing-library": "0.2.2",
    "@storybook/vue3-vite": "^9.1.9",
    "@testcontainers/postgresql": "11.8.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/vue": "8.1.0",
    "@types/bcrypt": "6.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/supertest": "6.0.3",
    "@vite-pwa/nuxt": "1.0.7",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "babel-loader": "10.0.0",
    "c8": "10.1.3",
    "concurrently": "9.2.1",
    "cypress": "15.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-storybook": "9.1.9",
    "eslint-plugin-vue": "10.6.0",
    "flush-promises": "1.0.2",
    "generate-changelog": "1.8.0",
    "glob": "11.0.3",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "jsdom": "27.2.0",
    "nuxt": "4.2.1",
    "nuxt-delay-hydration": "1.3.8",
    "nuxt-security": "2.5.0",
    "openapi-types": "12.1.3",
    "postcss": "8.5.6",
    "postcss-html": "1.8.0",
    "prettier": "3.6.2",
    "prettier-plugin-prisma": "5.0.0",
    "pretty-quick": "4.2.2",
    "sass": "1.94.2",
    "sass-loader": "16.0.6",
    "storybook": "^9.1.9",
    "stylelint": "16.26.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-scss": "6.12.1",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.2.4",
    "vitest": "3.2.4",
    "vue-loader": "17.4.2"
  },
  "overrides": {
    "vue": "3.5.4",
    "vite": "7.2.4",
    "vitest": "3.2.4",
    "storybook": "$storybook"
  }
}
